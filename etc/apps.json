{
  "apps": [
    {
      "id": "kodi",
      "name": "Kodi",
      "caption": {"en": "Movies, series, music and live TV", "cs": "Filmy, seriály, hudba a živá TV"},
      "tagline": {"en": "Your whole film and music library in one place", "cs": "Celá vaše knihovna filmů a hudby na jednom místě"},
      "category": "media",
      "color": "#1c2834",
      "text_color": "#17b2e7",
      "pkg": "kodi",
      "exec": ["kodi", "--standalone", "-fs"]
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "caption": {"en": "YouTube TV interface, remote friendly", "cs": "YouTube v TV rozhraní, pro ovladač"},
      "tagline": {"en": "Videos without the ads, made for the remote", "cs": "Videa bez reklam, uzpůsobená pro ovladač"},
      "category": "streaming",
      "color": "#ff0033",
      "text_color": "#ffffff",
      "pkg": "firefox",
      "exec": ["firefox", "--kiosk", "--profile", "{youtube_profile}", "{youtube_url}"]
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "caption": {"en": "Your own media server", "cs": "Váš vlastní mediální server"},
      "tagline": {"en": "Stream from your own server, no subscription", "cs": "Streamujte z vlastního serveru, bez předplatného"},
      "category": "media",
      "color": "#101018",
      "text_color": "#aa5cc3",
      "pkg": "firefox",
      "requires": ["jellyfin_url"],
      "exec": ["firefox", "--kiosk", "--profile", "{firefox_profile}", "{jellyfin_url}"]
    },
    {
      "id": "netflix",
      "name": "Netflix",
      "caption": {"en": "Series and films", "cs": "Seriály a filmy"},
      "tagline": {"en": "Series and films", "cs": "Seriály a filmy"},
      "category": "streaming",
      "color": "#000000",
      "text_color": "#e50914",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.netflix.com/"]
    },
    {
      "id": "disneyplus",
      "name": "Disney+",
      "caption": {"en": "Disney, Pixar, Marvel, Star Wars", "cs": "Disney, Pixar, Marvel, Star Wars"},
      "category": "streaming",
      "color": "#0e2a5c",
      "text_color": "#ffffff",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.disneyplus.com/"]
    },
    {
      "id": "primevideo",
      "name": "Prime Video",
      "caption": {"en": "Amazon Prime Video", "cs": "Amazon Prime Video"},
      "category": "streaming",
      "color": "#0f171e",
      "text_color": "#1a98ff",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.primevideo.com/"]
    },
    {
      "id": "max",
      "name": "Max",
      "caption": {"en": "HBO and more", "cs": "HBO a další"},
      "category": "streaming",
      "color": "#002be7",
      "text_color": "#ffffff",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://play.max.com/"]
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "caption": {"en": "Music and podcasts", "cs": "Hudba a podcasty"},
      "category": "streaming",
      "color": "#121212",
      "text_color": "#1ed760",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://open.spotify.com/"]
    },
    {
      "id": "browser",
      "name": "Web",
      "caption": {"en": "Firefox", "cs": "Firefox"},
      "tagline": {"en": "The whole web on the big screen", "cs": "Celý web na velké obrazovce"},
      "color": "#20123a",
      "text_color": "#ff7139",
      "pkg": "firefox",
      "exec": ["firefox", "--kiosk", "--profile", "{firefox_profile}", "https://duckduckgo.com"]
    },
    {
      "id": "iptv",
      "name": {"en": "Live TV", "cs": "Živá TV"},
      "caption": {"en": "IPTV playlist in mpv", "cs": "IPTV playlist v mpv"},
      "tagline": {"en": "Live channels from your IPTV playlist", "cs": "Živé kanály z vašeho IPTV playlistu"},
      "category": "media",
      "color": "#0b3d2c",
      "text_color": "#4ee3a0",
      "pkg": "mpv",
      "requires": ["iptv_playlist"],
      "exec": ["mpv", "--fs", "--input-default-bindings", "--osc=yes", "{iptv_playlist}"]
    },
    {
      "id": "moonlight",
      "name": "Moonlight",
      "caption": {"en": "Stream games from your PC", "cs": "Hry streamované z vašeho PC"},
      "tagline": {"en": "Play PC games on the sofa", "cs": "Hrajte hry z PC na gauči"},
      "category": "games",
      "color": "#26293b",
      "text_color": "#9fb4ff",
      "pkg": "moonlight-qt",
      "exec": ["moonlight"]
    },
    {
      "id": "retroarch",
      "name": "RetroArch",
      "caption": {"en": "Retro games", "cs": "Retro hry"},
      "category": "games",
      "color": "#2a2a2a",
      "text_color": "#e6e6e6",
      "pkg": "retroarch",
      "exec": ["retroarch", "--fullscreen"]
    },
    {
      "id": "music",
      "name": {"en": "Music", "cs": "Hudba"},
      "caption": {"en": "Local music library", "cs": "Místní hudební knihovna"},
      "category": "media",
      "color": "#3b0f24",
      "text_color": "#ff7ab0",
      "pkg": "mpv",
      "requires": ["music_dir"],
      "exec": ["mpv", "--fs", "--force-window=yes", "--shuffle", "{music_dir}"]
    }
  ]
}
