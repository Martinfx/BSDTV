{
  "apps": [
    {
      "id": "kodi",
      "name": "Kodi",
      "caption": "Movies, series, music and live TV",
      "color": "#17b2e7",
      "pkg": "kodi",
      "exec": ["kodi", "--standalone", "-fs"]
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "caption": "YouTube TV interface, remote friendly",
      "color": "#ff2d2d",
      "pkg": "firefox",
      "exec": ["firefox", "--kiosk", "--profile", "{youtube_profile}", "{youtube_url}"]
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "caption": "Your own media server",
      "color": "#8c4bdc",
      "pkg": "firefox",
      "requires": ["jellyfin_url"],
      "exec": ["firefox", "--kiosk", "--profile", "{firefox_profile}", "{jellyfin_url}"]
    },
    {
      "id": "netflix",
      "name": "Netflix",
      "caption": "Series and films",
      "color": "#e50914",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.netflix.com/"]
    },
    {
      "id": "disneyplus",
      "name": "Disney+",
      "caption": "Disney, Pixar, Marvel, Star Wars",
      "color": "#113ccf",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.disneyplus.com/"]
    },
    {
      "id": "primevideo",
      "name": "Prime Video",
      "caption": "Amazon Prime Video",
      "color": "#00a8e1",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://www.primevideo.com/"]
    },
    {
      "id": "max",
      "name": "Max",
      "caption": "HBO and more",
      "color": "#002be7",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://play.max.com/"]
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "caption": "Music and podcasts",
      "color": "#1db954",
      "pkg": "linux-brave",
      "requires": ["drm_browser"],
      "exec": ["{drm_browser}", "https://open.spotify.com/"]
    },
    {
      "id": "browser",
      "name": "Web",
      "caption": "Firefox",
      "color": "#ff7a18",
      "pkg": "firefox",
      "exec": ["firefox", "--kiosk", "--profile", "{firefox_profile}", "https://duckduckgo.com"]
    },
    {
      "id": "iptv",
      "name": "Live TV",
      "caption": "IPTV playlist in mpv",
      "color": "#1fbf75",
      "pkg": "mpv",
      "requires": ["iptv_playlist"],
      "exec": ["mpv", "--fs", "--input-default-bindings", "--osc=yes", "{iptv_playlist}"]
    },
    {
      "id": "moonlight",
      "name": "Moonlight",
      "caption": "Stream games from your PC",
      "color": "#3d63dd",
      "pkg": "moonlight-qt",
      "exec": ["moonlight"]
    },
    {
      "id": "retroarch",
      "name": "RetroArch",
      "caption": "Retro games",
      "color": "#5c5c5c",
      "pkg": "retroarch",
      "exec": ["retroarch", "--fullscreen"]
    },
    {
      "id": "music",
      "name": "Music",
      "caption": "Local music library",
      "color": "#e8457c",
      "pkg": "mpv",
      "requires": ["music_dir"],
      "exec": ["mpv", "--fs", "--force-window=yes", "--shuffle", "{music_dir}"]
    }
  ]
}
