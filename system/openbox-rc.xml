<?xml version="1.0" encoding="UTF-8"?>
<!-- BSDTV: openbox as an invisible window manager. Every window is
     undecorated and maximized; remote keys are bound globally so Home and
     volume work inside any app. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>

  <keyboard>
    <!-- Home: close the running app and show the launcher. Remotes call this
         button Home, Exit or Close; on a keyboard F12, Win+H and Alt+F4 work. -->
    <keybind key="XF86HomePage"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>
    <keybind key="XF86Exit"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>
    <keybind key="XF86Close"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>
    <keybind key="W-h"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>
    <keybind key="F12"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>
    <keybind key="A-F4"><action name="Execute"><command>bsdtv-ctl home</command></action></keybind>

    <!-- Volume talks to mixer(8) directly so it works even if the launcher is restarting. -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>mixer vol.volume=+5%</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>mixer vol.volume=-5%</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>mixer vol.mute=^</command></action></keybind>

    <keybind key="XF86Sleep"><action name="Execute"><command>xset dpms force off</command></action></keybind>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <context name="Root"></context>
  </mouse>

  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
